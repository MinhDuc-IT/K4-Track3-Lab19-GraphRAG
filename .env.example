# cp .env.example .env
# --- Neo4j Database (Local Docker hoặc Neo4j AuraDB) ---
NEO4J_URI=neo4j+s://<your-instance-id>.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-neo4j-password
NEO4J_DATABASE=neo4j

# --- Extraction & Generation LLM (Groq) ---
GROQ_API_KEY=gsk_...
GROQ_MODEL=qwen/qwen3.6-27b

# --- LLM-as-a-Judge (OpenAI / OpenRouter / Groq) ---
# OpenRouter: JUDGE_PROVIDER=openai, key sk-or-v1-..., model dạng openai/gpt-4o-mini
JUDGE_PROVIDER=openai
JUDGE_MODEL=openai/gpt-4o-mini
OPENAI_API_KEY=sk-or-v1-...
OPENAI_BASE_URL=https://openrouter.ai/api/v1

# --- Hugging Face Access Token (để stream dataset HackerNoon) ---
HF_TOKEN=hf_...
